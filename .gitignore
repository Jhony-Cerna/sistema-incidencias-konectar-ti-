# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build outputs
backend/dist/
frontend/dist/

# Environment variables
.env
backend/.env
frontend/.env

# Local database runtime files (recreated via seed)
backend/data/*.sqlite-shm
backend/data/*.sqlite-wal
backend/data/*_test.sqlite*

# Uploaded runtime files (keep directory)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs, Vercel & OS
*.log
.vercel
.DS_Store
Thumbs.db
