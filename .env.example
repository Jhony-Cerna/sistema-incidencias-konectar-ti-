# ==============================================================================
# KONECTAR BPO S.A.C. - Sistema Web de Gestión y Seguimiento de Incidencias TI
# Archivo de ejemplo de variables de entorno (copiar a backend/.env)
# ==============================================================================

NODE_ENV=development
PORT=4000

# Seguridad JWT (Cambiar en entorno de producción)
JWT_SECRET=konectar_bpo_itsm_sede_lima_norte_jwt_secret_2026_secure
JWT_EXPIRES_IN=12h

# Base de Datos Relacional SQLite (ACID + Integridad Referencial)
DB_PATH=./data/konectar_itsm.sqlite

# Directorio de evidencias y adjuntos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# URL permitida para CORS (Frontend)
CORS_ORIGIN=http://localhost:5173
